# Copy to .env (git-ignored) and fill in. Never commit real values.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Identifying User-Agent required by Overpass and Nominatim. Use a team contact, not a personal one.
USER_AGENT=MIT-AT-CarToCurb/0.1 (team contact email)
MAPILLARY_TOKEN=
DATABASE_PATH=./data/cache.sqlite3
