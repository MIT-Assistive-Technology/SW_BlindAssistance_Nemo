{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden location",
  "description": "One entry in golden/locations.json. Ground truth comes from a tape measure off a surveyed corner, an RTK receiver or a survey marker. Never from OSM, never from phone GPS. Measured values stay null until someone has been on site.",
  "type": "object",
  "required": [
    "id", "status", "address", "scenario", "tags", "counts_toward_april", "why_chosen",
    "entrance_truth", "drop_off_points", "accessible_entrance", "osm_snapshot", "photos",
    "truth_uncertain", "todo"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "status": {
      "description": "template: nothing measured yet. measured: entrance_truth filled in from >= 2 measurements.",
      "enum": ["template", "measured"]
    },
    "address": {"type": "string", "minLength": 1},
    "fixture_id": {
      "description": "Matching id in server/tests/fixtures/nominatim/addresses.json, if any.",
      "type": ["string", "null"]
    },
    "scenario": {
      "description": "Primary scenario from plan section 18. Decides the site mix.",
      "enum": ["same_side", "driveway", "opposite_side", "campus"]
    },
    "tags": {
      "description": "Extra difficulty tags. both_sides_dropoff and one_way must each appear at least once in the set.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "same_side", "driveway", "garage", "opposite_side", "campus", "hotel", "one_way",
          "both_sides_dropoff", "corner_building", "bike_lane", "wide_avenue", "median",
          "address_not_door", "many_doors", "locked_doors", "neighbor_doors", "revolving_door",
          "steps", "ramp"
        ]
      }
    },
    "counts_toward_april": {
      "description": "True for same_side and driveway sites (they gate the April freeze). Opposite side and campus are measured only.",
      "type": "boolean"
    },
    "why_chosen": {"type": "string", "minLength": 1},
    "building_osm_id": {
      "description": "OSM id of the destination building (e.g. 'way/123'), confirmed on site. Lets the evaluation check that the bundle picked the right building.",
      "type": ["string", "null"]
    },
    "entrance_truth": {
      "type": "object",
      "required": ["lat", "lon", "method", "reference_point", "measured_on", "measurements", "spread_m"],
      "additionalProperties": false,
      "properties": {
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "method": {"enum": ["tape_from_corner", "rtk", "survey_marker", null]},
        "reference_point": {
          "description": "The surveyed corner or marker the tape starts from, with where its coordinates came from (RTK fix, city survey). Never an OSM node.",
          "type": ["object", "null"],
          "required": ["description", "lat", "lon", "source"],
          "additionalProperties": false,
          "properties": {
            "description": {"type": "string"},
            "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
            "source": {"enum": ["rtk", "survey_marker", "city_survey", null]}
          }
        },
        "measured_on": {
          "type": "array",
          "items": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        },
        "measurements": {
          "description": "Every independent measurement of the door point. lat/lon is the average of these.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lat", "lon", "method", "measured_on"],
            "additionalProperties": false,
            "properties": {
              "lat": {"type": "number", "minimum": -90, "maximum": 90},
              "lon": {"type": "number", "minimum": -180, "maximum": 180},
              "method": {"enum": ["tape_from_corner", "rtk", "survey_marker"]},
              "measured_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "along_m": {"description": "Tape distance along the facade from the reference point.", "type": "number", "minimum": 0},
              "offset_m": {"description": "Perpendicular distance out from the facade (positive = toward the street).", "type": "number"},
              "facade_bearing_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
              "note": {"type": "string"}
            }
          }
        },
        "spread_m": {
          "description": "Largest distance between any two measurements, in metres. Over 2 m means truth_uncertain.",
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "drop_off_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "lat", "lon", "street", "curb_side", "side_vs_door", "one_way"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
          "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
          "street": {"type": ["string", "null"]},
          "curb_side": {
            "description": "Side of the street centerline (first point to last point, as in plan section 6) the car stops on.",
            "enum": ["left", "right", null]
          },
          "side_vs_door": {"enum": ["same", "opposite", null]},
          "one_way": {"type": ["boolean", "null"]},
          "note": {"type": "string"}
        }
      }
    },
    "accessible_entrance": {
      "type": "object",
      "required": ["is_main_entrance", "steps", "ramp", "revolving_door", "automatic_door", "notes"],
      "additionalProperties": false,
      "properties": {
        "is_main_entrance": {"type": ["boolean", "null"]},
        "steps": {"type": ["integer", "null"], "minimum": 0},
        "ramp": {"type": ["boolean", "null"]},
        "revolving_door": {"type": ["boolean", "null"]},
        "automatic_door": {"type": ["boolean", "null"]},
        "notes": {"type": "string"}
      }
    },
    "osm_snapshot": {
      "description": "What OSM said on the snapshot date. Used to score OSM, never as truth.",
      "type": "object",
      "required": ["taken_on", "has_entrance_tag", "entrance_tag", "distance_to_truth_m"],
      "additionalProperties": false,
      "properties": {
        "taken_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "has_entrance_tag": {"type": ["boolean", "null"]},
        "entrance_tag": {"type": ["string", "null"]},
        "distance_to_truth_m": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "shows"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "shows": {"type": "string", "minLength": 1},
          "taken_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "truth_uncertain": {
      "description": "True when spread_m > 2 or fewer than 2 measurements agree. Uncertain sites are excluded from scoring.",
      "type": "boolean"
    },
    "todo": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "measured"}}, "required": ["status"]},
      "then": {
        "properties": {
          "entrance_truth": {
            "properties": {
              "lat": {"type": "number"},
              "lon": {"type": "number"},
              "method": {"enum": ["tape_from_corner", "rtk", "survey_marker"]},
              "measured_on": {"minItems": 1},
              "measurements": {"minItems": 2},
              "spread_m": {"type": "number"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entrance_truth": {
            "properties": {"spread_m": {"type": "number", "exclusiveMinimum": 2}},
            "required": ["spread_m"]
          }
        },
        "required": ["entrance_truth"]
      },
      "then": {"properties": {"truth_uncertain": {"const": true}}}
    },
    {
      "if": {"properties": {"scenario": {"enum": ["same_side", "driveway"]}}, "required": ["scenario"]},
      "then": {"properties": {"counts_toward_april": {"const": true}}},
      "else": {"properties": {"counts_toward_april": {"const": false}}}
    }
  ]
}
